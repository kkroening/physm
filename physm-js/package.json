{
  "name": "physm-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "prebuild": "npm run wasm",
    "predev": "npm run wasm",
    "pretest": "npm run wasm:node",
    "preview": "vite preview",
    "setup": "npm run wasm && npm run wasm:node && npm install",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "wasm": "wasm-pack build --target bundler ../physm-rs",
    "wasm:node": "wasm-pack build --target nodejs --out-dir nodepkg ../physm-rs"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "normalize.css": "^8.0.1",
    "physm-rs": "file:../physm-rs/pkg",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.0.0"
  }
}
