{
  "name": "physm-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build --target bundler ../physm-rs",
    "tfwasm": "node scripts/copy-tfjs-wasm.mjs",
    "setup": "npm run wasm && npm run wasm:node && npm install",
    "predev": "npm run wasm && npm run tfwasm",
    "dev": "vite",
    "prebuild": "npm run wasm && npm run tfwasm",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run wasm:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm:node": "wasm-pack build --target nodejs --out-dir nodepkg ../physm-rs"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "immer": "^10.1.1",
    "normalize.css": "^8.0.1",
    "physm-rs": "file:../physm-rs/pkg",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "react-test-renderer": "^19.0.8",
    "vite": "^7.0.0",
    "vite-plugin-wasm": "^3.4.1",
    "vitest": "^3.0.0"
  }
}
